#:import dp kivy.metrics.dp

<LoginScreen>:
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.backgroundColor

    MDIconButton:
        icon: "arrow-left"
        pos_hint: {"x": .05, "top": .92}
        theme_icon_color: "Custom"
        icon_color: app.theme_cls.primaryColor
        on_release: root.volver()

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        size_hint_x: None
        width: "320dp"
        spacing: "14dp"
        pos_hint: {"center_x": .5, "center_y": .5}

        MDLabel:
            text: "Iniciar sesión"
            font_style: "Headline"
            role: "small"
            theme_font_size: "Custom"
            font_size: "30sp"
            bold: True
            halign: "center"
            adaptive_height: True
            padding: 0, 0, 0, "16dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primaryColor

        MDTextField:
            id: correo
            mode: "filled"
            size_hint_y: None
            height: "56dp"
            radius: [dp(8), dp(8), dp(8), dp(8)]
            theme_bg_color: "Custom"
            fill_color_normal: app.theme_cls.surfaceContainerHighestColor
            fill_color_focus: app.theme_cls.surfaceContainerHighColor
            theme_line_color: "Custom"
            line_color_normal: 0, 0, 0, 0
            line_color_focus: app.theme_cls.primaryColor

            MDTextFieldHintText:
                text: "Correo"
                theme_text_color: "Custom"
                text_color_normal: app.theme_cls.onSurfaceVariantColor
                text_color_focus: app.theme_cls.primaryColor

        MDTextField:
            id: contrasena
            mode: "filled"
            size_hint_y: None
            height: "56dp"
            radius: [dp(8), dp(8), dp(8), dp(8)]
            theme_bg_color: "Custom"
            fill_color_normal: app.theme_cls.surfaceContainerHighestColor
            fill_color_focus: app.theme_cls.surfaceContainerHighColor
            theme_line_color: "Custom"
            line_color_normal: 0, 0, 0, 0
            line_color_focus: app.theme_cls.primaryColor
            password: True

            MDTextFieldHintText:
                text: "Contraseña"
                theme_text_color: "Custom"
                text_color_normal: app.theme_cls.onSurfaceVariantColor
                text_color_focus: app.theme_cls.primaryColor

        MDButton:
            style: "filled"
            theme_width: "Custom"
            theme_height: "Custom"
            size_hint: 1, None
            height: "48dp"
            radius: [dp(6), dp(6), dp(6), dp(6)]
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor
            on_release: root.iniciar_sesion()

            MDButtonText:
                text: "Iniciar sesión"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: app.theme_cls.onPrimaryColor
                bold: True
